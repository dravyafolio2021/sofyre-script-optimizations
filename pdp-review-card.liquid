{%- liquid
  assign has_content = false
  if block.settings.quote_headline != blank or block.settings.body != blank or block.settings.quote_pain != blank
    assign has_content = true
  endif
-%}

{%- if has_content -%}
  <li class="pdp-review-wall__card" {{ block.shopify_attributes }}>
    <div class="pdp-review-wall__card-body">
      <div class="pdp-review-wall__card-top">
        {%- if block.settings.show_stars and section_settings.stars_image != blank -%}
          <span class="pdp-review-wall__stars" role="img" aria-label="Rated 5 out of 5 stars">
            <img src="{{ section_settings.stars_image | image_url: width: 160 }}" width="80" height="17" alt="" loading="lazy" decoding="async" fetchpriority="low">
          </span>
        {%- endif -%}
        {%- if block.settings.verified_label != blank -%}
          <span class="pdp-review-wall__verified">
            {%- if section_settings.verified_icon != blank -%}
              <img src="{{ section_settings.verified_icon | image_url: width: 28 }}" width="14" height="14" alt="" loading="lazy" decoding="async" fetchpriority="low">
            {%- endif -%}
            {{ block.settings.verified_label }}
          </span>
        {%- endif -%}
      </div>

      {%- if block.settings.quote_pain != blank -%}
        <p class="pdp-review-wall__quote-pain">{{ block.settings.quote_pain }}</p>
      {%- endif -%}

      {%- if block.settings.quote_headline != blank -%}
        <p class="pdp-review-wall__quote-headline">{{ block.settings.quote_headline }}</p>
      {%- endif -%}

      {%- if block.settings.body != blank -%}
        <div class="pdp-review-wall__story" data-pdp-review-wall-story>
          {{ block.settings.body }}
        </div>
        <button type="button" class="pdp-review-wall__read-more" data-pdp-review-wall-read-more aria-expanded="false" hidden>
          <span class="pdp-review-wall__read-more-open">Read more</span>
          <span class="pdp-review-wall__read-more-close">Read less</span>
        </button>
      {%- endif -%}

      <footer class="pdp-review-wall__card-footer">
        {%- if block.settings.photo != blank -%}
          <img
            class="pdp-review-wall__avatar"
            src="{{ block.settings.photo | image_url: width: 160 }}"
            srcset="{{ block.settings.photo | image_url: width: 80 }} 80w, {{ block.settings.photo | image_url: width: 160 }} 160w"
            sizes="80px"
            width="80"
            height="80"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            alt="{{ block.settings.photo.alt | default: block.settings.author | escape }}"
          >
        {%- endif -%}

        <div class="pdp-review-wall__card-identity">
          {%- if block.settings.author != blank -%}
            <p class="pdp-review-wall__author">{{ block.settings.author }}</p>
          {%- endif -%}
          {%- if block.settings.meta != blank -%}
            <p class="pdp-review-wall__meta">{{ block.settings.meta }}</p>
          {%- endif -%}
          {%- if block.settings.purchased != blank -%}
            {%- assign purchased_label = block.settings.purchased | split: ':' | first -%}
            {%- if block.settings.purchased contains ':' -%}
              {%- assign purchased_value = block.settings.purchased | remove_first: purchased_label | remove_first: ':' -%}
              <p class="pdp-review-wall__purchased"><strong>{{ purchased_label }}:</strong>{{ purchased_value }}</p>
            {%- else -%}
              <p class="pdp-review-wall__purchased">{{ block.settings.purchased }}</p>
            {%- endif -%}
          {%- endif -%}
        </div>
      </footer>
    </div>
  </li>
{%- endif -%}
