{%- if template.name == 'product' -%}
  {%- assign lcp_media = product.selected_or_first_available_variant.featured_media | default: product.featured_image -%}
  {%- if lcp_media -%}
    <link rel="preload" as="image" href="{{ lcp_media | image_url: width: 800 }}" fetchpriority="high" imagesrcset="{%- if lcp_media.width >= 360 -%}{{ lcp_media | image_url: width: 360 }} 360w,{%- endif -%}{%- if lcp_media.width >= 533 -%}{{ lcp_media | image_url: width: 533 }} 533w,{%- endif -%}{%- if lcp_media.width >= 720 -%}{{ lcp_media | image_url: width: 720 }} 720w,{%- endif -%}{%- if lcp_media.width >= 900 -%}{{ lcp_media | image_url: width: 900 }} 900w,{%- endif -%}{{ lcp_media | image_url: width: 1200 }} 1200w" imagesizes="(min-width: 990px) 50vw, 100vw">
  {%- endif -%}
{%- endif -%}

