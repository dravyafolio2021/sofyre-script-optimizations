<script>
  if (window.requestIdleCallback) {
    requestIdleCallback(function() {
      localStorage.setItem('nb__region_code', "{{ localization.country.iso_code }}");
      localStorage.setItem('nb__currency_code', "{{ localization.country.currency.iso_code }}");
    });
  } else {
    setTimeout(function() {
      localStorage.setItem('nb__region_code', "{{ localization.country.iso_code }}");
      localStorage.setItem('nb__currency_code', "{{ localization.country.currency.iso_code }}");
    }, 3000);
  }
</script>

{%- if template.name == 'customers/account' or request.path contains 'loop' -%}
<script type="text/javascript">
  document.addEventListener('sealsubs_portal:loaded', function (e) {
    ChurnBuster = window.ChurnBuster || {};
    ChurnBuster.cancelAttributes = {
      accountId: 'e365eade-f214-40d6-8c9a-d2b4637c2e95',
      source: 'seal',
      customerId: window.sealsubscriptions.subscription.customer_id,
      customerEmail: document.querySelector('.seal-email-address input[name="email"]').value,
      subscriptionId: window.sealsubscriptions.subscription.id,
      cancelButtonSelector: 'div#seal-unsubscribe-button',
    };

    var script = document.createElement('script');
    script.type = 'text/javascript';
    script.async = true;
    script.src = 'https://proxy-assets.churnbuster.io/v4/scripts.js?v=1678742553659';
    var insert = document.getElementsByTagName('script')[0];
    insert.parentNode.insertBefore(script, insert);
  });
</script>
{%- endif -%}
