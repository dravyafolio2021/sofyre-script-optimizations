{%- assign s = block.settings -%}
<div class="product__accordion accordion accordion--medium quick-add-hidden pdp-buybox-accordion" style="--margin-top: {{ s.margin_top | divided_by: 10.0 }}rem;--margin-bottom: {{ s.margin_bottom | divided_by: 10.0 }}rem;" {{ block.shopify_attributes }}>
  <details class="accordion__details"{% if s.open %} open{% endif %}>
    <summary class="accordion__summary">
      <div class="summary__title">
        <h2 class="h4 accordion__title">{{ s.heading | escape }}</h2>
      </div>
      {% render 'icon-caret' %}
    </summary>
  </details>
  <div class="accordion__content-wrapper">
    <div class="accordion__content pdp-buybox-accordion__content" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
      {%- if block.type == 'pdp_accordion_cards' -%}
        {%- for i in (1..6) -%}
          {%- assign key = 'text_' | append: i -%}
          {%- assign card_text = s[key] -%}
          {%- if card_text == blank -%}{%- continue -%}{%- endif -%}
          {%- assign key = 'pill_' | append: i -%}
          {%- assign card_pill = s[key] -%}
          {%- assign key = 'dark_' | append: i -%}
          {%- assign card_dark = s[key] -%}
          <div class="pdp-buybox-accordion__card{% if card_dark %} pdp-buybox-accordion__card--dark{% endif %}">
            {%- if card_pill != blank -%}
              <span class="pdp-buybox-accordion__pill{% if card_dark %} pdp-buybox-accordion__pill--dark{% endif %}">
                {%- if card_dark -%}
                  {%- if s.dark_icon != blank -%}
                    <img src="{{ s.dark_icon | image_url: width: 30 }}" width="15" height="15" alt="" loading="lazy" decoding="async" fetchpriority="low">
                  {%- else -%}
                    {%- render 'pdp-icon-info' -%}
                  {%- endif -%}
                {%- endif %}
                {{ card_pill | escape }}
              </span>
            {%- endif -%}
            <p class="pdp-buybox-accordion__text{% if card_dark %} pdp-buybox-accordion__text--light{% endif %}">{{ card_text }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="pdp-buybox-accordion__grid">
          {%- for i in (1..4) -%}
            {%- assign key = 'title_' | append: i -%}
            {%- assign cell_title = s[key] -%}
            {%- assign key = 'image_' | append: i -%}
            {%- assign cell_image = s[key] -%}
            {%- assign key = 'chip_' | append: i -%}
            {%- assign cell_chip = s[key] -%}
            {%- assign key = 'caption_' | append: i -%}
            {%- assign cell_caption = s[key] -%}
            {%- if cell_title == blank and cell_chip == blank and cell_image == blank -%}{%- continue -%}{%- endif -%}
            <div class="pdp-buybox-accordion__cell">
              {%- if cell_title != blank -%}
                <p class="pdp-buybox-accordion__cell-title">{{ cell_title | escape }}</p>
              {%- endif -%}
              {%- if cell_image != blank -%}
                <img class="pdp-buybox-accordion__cell-img" src="{{ cell_image | image_url: width: 300 }}" alt="{{ cell_image.alt | default: cell_chip | escape }}" loading="lazy" decoding="async" fetchpriority="low" width="{{ cell_image.width }}" height="{{ cell_image.height }}">
              {%- endif -%}
              {%- if cell_chip != blank -%}
                <span class="pdp-buybox-accordion__chip">{{ cell_chip | escape }}</span>
              {%- endif -%}
              {%- if cell_caption != blank -%}
                <p class="pdp-buybox-accordion__cell-caption">{{ cell_caption | escape }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if s.rec_text != blank -%}
        <div class="pdp-buybox-accordion__rec">
          {%- if s.rec_label != blank -%}
            <p class="pdp-buybox-accordion__rec-label">{{ s.rec_label | escape }}</p>
          {%- endif -%}
          <p class="pdp-buybox-accordion__rec-text">{{ s.rec_text }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
